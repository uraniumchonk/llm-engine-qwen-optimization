+@triton.jit
+def _decode_e4m3fn(data):
+    """Decode raw E4M3FN bytes without native FP8 instructions.
+
+    The half bit layout preserves normal/subnormal significands. Multiplying
+    by 2**8 corrects the exponent bias, exactly in fp32. E4M3FN reserves both
+    encodings with magnitude 0x7f for NaN, not +/-480.
+    """
+    b = data.to(tl.uint16)
+    h = ((b & 0x80) << 8) | ((b & 0x7F) << 7)
+    f = h.to(tl.float16, bitcast=True).to(tl.float32) * 256.0
+    bits = f.to(tl.uint32, bitcast=True)
+    nan_bits = ((b.to(tl.uint32) & 0x80) << 24) | 0x7FC00000
+    return tl.where((b & 0x7F) == 0x7F, nan_bits, bits).to(
+        tl.float32, bitcast=True
+    )
+
