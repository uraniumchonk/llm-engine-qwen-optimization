+def _e031_verify_block_copies(kv_caches, num_blocks, kv_cache_block_copies) -> None:
+    # E031 debug: every per-layer tensor (no de-duplication) must hold equal
+    # bytes in each copied block pair after copy_kv_cache_blocks_inplace.
+    pairs = [(int(c[0]), int(c[1])) for c in kv_cache_block_copies]
+    bad = []
