+    @classmethod
+    def _e031_fine_grained_hit(
+        cls,
+        block_hashes: BlockHashList,
+        max_length: int,
+        kv_cache_group_ids: list[int],
+        block_pool: BlockPool,
+        kv_cache_spec: SlidingWindowSpec,
+        drop_eagle_block: bool,
+        alignment_tokens: int,
+    ) -> tuple[tuple[list[KVCacheBlock], ...], int]:
+        """Longest hit on the hash-unit grid (E031).
+
+        Candidates are final hit lengths ``f`` on the hash-unit grid, longest
+        first. The block holding token ``f - 1`` is proven by a cached key:
+        with ``drop_eagle_block`` the key one hash unit past ``f`` (EAGLE
+        matches one unit further and drops it; the drafter KV at ``f - 1``
+        reads token ``f``); without it the key at ``f``, or the key one unit
+        past ``f`` in the same block (KV is append-only). A full-block key is
+        the last hash unit of the block (``BlockHashListWithBlockSize``); a
+        mid-block key is the partial-tail entry ``cache_blocks`` registers at
+        the prompt's last hash boundary. Continuing at ``f`` needs the KV of
+        tokens ``[f - sliding_window + 1, f)``; blocks before that are null
+        blocks, as in the block-granular search.
+        """
+        assert isinstance(block_hashes, Sequence)
+        assert not isinstance(block_hashes, BlockHashListWithBlockSize)
+        unit = alignment_tokens
+        block_size = kv_cache_spec.block_size
+        window = kv_cache_spec.sliding_window
+        null_block = block_pool.null_block
+        num_groups = len(kv_cache_group_ids)
+        units_per_block = block_size // unit
+        total_units = len(block_hashes)
+        lookups: dict[int, tuple[KVCacheBlock, ...] | None] = {}
+
+        def cached_at(num_units: int) -> tuple[KVCacheBlock, ...] | None:
+            # Key of the prefix of ``num_units`` hash units.
+            if num_units not in lookups:
+                lookups[num_units] = block_pool.get_cached_block(
+                    block_hashes[num_units - 1], kv_cache_group_ids
+                )
+            return lookups[num_units]
+
+        if drop_eagle_block:
+            n = min(max_length // unit - 1, total_units - 1)
+        else:
+            n = min(max_length // unit, total_units)
+        while n > 0:
+            final = n * unit
+            mid_block = final % block_size != 0
+            tail = None
+            if drop_eagle_block:
+                if cached_at(n + 1):
+                    tail = cached_at(n + 1) if mid_block else cached_at(n)
+            else:
+                tail = cached_at(n)
+                if not tail and mid_block and n < total_units:
+                    tail = cached_at(n + 1)
+            if not tail:
+                n -= 1
+                continue
+            tail_block = (final - 1) // block_size
+            first_block = max(0, final - window + 1) // block_size
+            missing = None
