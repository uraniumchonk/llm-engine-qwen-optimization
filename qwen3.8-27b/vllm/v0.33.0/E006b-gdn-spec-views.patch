+def strided_qkv_views(
+    mixed_qkv: torch.Tensor,
+    q_dim: int,
+    k_dim: int,
+    v_dim: int,
+    head_k_dim: int,
+    head_v_dim: int,
+    seq_len: int,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """q, k, v as (1, seq, heads, dim).
+
+    Last-dim stride 1: views into ``mixed_qkv``. Element (t, h, d) of q is
+    ``mixed_qkv[t, h * head_k_dim + d]``; k starts at column ``q_dim``; v
+    starts at column ``q_dim + k_dim``. Otherwise one contiguous copy each.
+    """
+    if (
+        mixed_qkv.ndim == 2
+        and mixed_qkv.stride(-1) == 1
+        and q_dim % head_k_dim == 0
+        and k_dim % head_k_dim == 0
+        and v_dim % head_v_dim == 0
+    ):
+        h = q_dim // head_k_dim
+        vh = v_dim // head_v_dim
+        row_stride = mixed_qkv.stride(0)
+        base_off = mixed_qkv.storage_offset()
+        query = mixed_qkv.as_strided(
+            (1, seq_len, h, head_k_dim),
+            (0, row_stride, head_k_dim, 1),
+            storage_offset=base_off,
+        )
+        key = mixed_qkv.as_strided(
+            (1, seq_len, h, head_k_dim),
+            (0, row_stride, head_k_dim, 1),
+            storage_offset=base_off + q_dim,
+        )
+        value = mixed_qkv.as_strided(
+            (1, seq_len, vh, head_v_dim),
+            (0, row_stride, head_v_dim, 1),
+            storage_offset=base_off + q_dim + k_dim,
+        )
+        return query, key, value
+
+    query, key, value = torch.split(mixed_qkv, [q_dim, k_dim, v_dim], dim=-1)
+    query = query.contiguous().view(1, seq_len, -1, head_k_dim)
+    key = key.contiguous().view(1, seq_len, -1, head_k_dim)
+    value = value.contiguous().view(1, seq_len, -1, head_v_dim)
+    return query, key, value
+
