@@ -147,3 +147,33 @@ def small_m_bf16_linear(
     if bias is not None:
         y = y + bias.float()
     return y.to(x.dtype)
+
+
+# E006c: torch.compile traces UnquantizedLinearMethod.apply with a symbolic M
+# (the general graph is traced at max_num_batched_tokens), so a Python
+# `x.shape[0] <= 16` test there is resolved once at trace time and the
+# compiled graph always calls F.linear (E008-a: no _small_m_splitk_kernel in
+# the 0.33 trace). Registering the call as an opaque custom op moves the
+# M <= MAX_M dispatch to run time, including CUDA-graph capture per size.
+_E006_ON = __import__("os").environ.get("VLLM_E006_SMALL_M", "1") != "0"
+
+
+def _small_m_bf16_linear_op(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    # The switch is read here (run time): an env var is not part of the
+    # torch.compile AOT cache key, so a trace-time check would be reused.
+    if not _E006_ON:
+        return torch.nn.functional.linear(x, weight)
+    return small_m_bf16_linear(x, weight, None)
+
+
+def _small_m_bf16_linear_fake(x: torch.Tensor, weight: torch.Tensor) -> torch.Tensor:
+    return x.new_empty((x.shape[0], weight.shape[0]))
+
+
+from vllm.utils.torch_utils import direct_register_custom_op  # noqa: E402
+
+direct_register_custom_op(
+    op_name="small_m_bf16_linear",
+    op_func=_small_m_bf16_linear_op,
+    fake_impl=_small_m_bf16_linear_fake,
+)
