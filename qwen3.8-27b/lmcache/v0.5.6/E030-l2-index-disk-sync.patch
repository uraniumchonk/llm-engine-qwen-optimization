+def _meow_filename_to_key(name: str) -> Optional[ObjectKey]:
+    """E030: reverse ``_object_key_to_filename`` (flat layout).
+
+    ``<model with / as -->_<kv_rank 08x>_<group x>_<hash hex>[@salt].bin``.
+    Returns None unless the key maps back to exactly ``name``.
+    """
+    if not name.endswith(".bin"):
+        return None
+    stem = name[: -len(".bin")]
+    salt = ""
+    if "@" in stem:
+        stem, salt = stem.rsplit("@", 1)
+    parts = stem.rsplit("_", 3)
+    if len(parts) != 4:
+        return None
+    model_s, rank_s, group_s, hash_s = parts
+    try:
+        key = ObjectKey(
+            chunk_hash=bytes.fromhex(hash_s),
+            model_name=model_s.replace("--", "/"),
+            kv_rank=int(rank_s, 16),
+            object_group_id=int(group_s, 16),
+            cache_salt=salt,
+        )
+    except ValueError:
+        return None
+    if _object_key_to_filename(key) != name:
+        return None
+    return key
+
