+    def register_listener(self, listener) -> None:
+        """Register a listener; with E030 on, seed it with the keys indexed
+        from disk at start, oldest file first, one key per call so every
+        eviction policy sees them in file-age order."""
+        super().register_listener(listener)
+        if not self._meow_rebuilt:
+            return
+        try:
+            for key, size in self._meow_rebuilt:
+                listener.on_l2_keys_stored([key], [size])
+        except Exception as e:
+            logger.warning("LMCACHE_MEOW_L2_SYNC: listener seed failed: %s", e)
+
+    def _meow_rebuild_index_from_disk(self) -> None:
+        """Index the data files already in the (flat) storage directory."""
+        agent = self.nixl_agent
+        root = getattr(agent, "file_path", None)
+        if root is None or getattr(agent, "shard_dirs", False):
+            logger.warning(
+                "LMCACHE_MEOW_L2_SYNC: index rebuild supports the flat file "
+                "layout only; skipped"
+            )
+            return
+        found: list[tuple[float, ObjectKey, int]] = []
+        skipped = 0
+        with os.scandir(root) as it:
+            for entry in it:
+                if not entry.name.endswith(".bin"):
+                    continue
+                if not entry.is_file(follow_symlinks=False):
+                    continue
+                key = _meow_filename_to_key(entry.name)
+                if key is None:
+                    skipped += 1
+                    continue
+                st = entry.stat(follow_symlinks=False)
+                found.append((st.st_mtime, key, st.st_size))
+        found.sort(key=lambda t: t[0])
+        rebuilt: list[tuple[ObjectKey, int]] = []
+        with self._lock:
+            for _, key, size in found:
+                if key in self._memory_objects:
+                    continue
+                self._memory_objects[key] = NixlStoreObj(
+                    page_indices=[], size=size, layout=None
+                )
+                self._total_bytes += size
+                rebuilt.append((key, size))
+        by_salt: dict[str, int] = {}
+        total = 0
+        for key, size in rebuilt:
+            by_salt[key.cache_salt] = by_salt.get(key.cache_salt, 0) + size
+            total += size
+        with self._usage_lock:
+            self._total_bytes_used += total
+            for salt, d in by_salt.items():
+                self._bytes_by_cache_salt[salt] = (
+                    self._bytes_by_cache_salt.get(salt, 0) + d
+                )
+        self._meow_rebuilt = rebuilt
+        logger.info(
+            "LMCACHE_MEOW_L2_SYNC: indexed %d files (%d bytes) from %s; "
+            "%d .bin names not parsed",
+            len(rebuilt),
+            total,
+            root,
+            skipped,
+        )
