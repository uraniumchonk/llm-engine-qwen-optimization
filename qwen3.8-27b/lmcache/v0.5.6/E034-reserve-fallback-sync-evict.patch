+            return 0
+        with self._meow_evict_lock:
+            used0, total = self._l1_manager.get_memory_usage()
+            if total <= 0 or used0 <= 0:
+                return 0
+            target = need_bytes
+            freed = 0
+            for _ in range(3):
+                used, _total = self._l1_manager.get_memory_usage()
+                ratio = min(0.5, max(0.01, 1.25 * (target - freed) / max(used, 1)))
+                actions = self._eviction_policy.get_eviction_actions(
+                    ratio,
+                    key_eligible_filter=self._l1_manager.is_key_evictable,
+                )
