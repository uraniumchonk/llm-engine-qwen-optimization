+                    self._meow_stats["keys"] += len(action.keys)
+                used_after, _total = self._l1_manager.get_memory_usage()
+                freed = used0 - used_after
+                if freed >= target:
+                    break
+            self._meow_stats["calls"] += 1
+            self._meow_stats["bytes_freed"] += max(0, freed)
+            if freed < target:
+                self._meow_stats["short"] += 1
+            logger.info(
+                "E034 sync evict: need %.1f MiB, freed %.1f MiB (usage %.1f%% -> %.1f%%)",
+                target / 2**20,
+                max(0, freed) / 2**20,
+                100.0 * used0 / total,
+                100.0 * (used0 - freed) / total,
+            )
+            return max(0, freed)
